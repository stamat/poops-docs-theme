{
  "styles": [{
    "in": "scss/docs.scss",
    "out": "dist/css/docs.css",
    "options": {
      "minify": true,
      "justMinified": true
    }
  }, {
    "in": "scss/prose-only.scss",
    "out": "dist/css/prose.css",
    "options": {
      "minify": true,
      "justMinified": true
    }
  }],
  "scripts": [{
    "in": "src/docs.ts",
    "out": "dist/js/docs.js",
    "options": {
      "minify": true,
      "justMinified": true,
      "format": "iife"
    }
  }, {
    "in": "src/prose.ts",
    "out": "dist/js/prose.js",
    "options": {
      "minify": true,
      "justMinified": true,
      "format": "iife"
    }
  }],
  "markup": {
    "in": "preview/src",
    "out": "preview/dist",
    "options": {
      "site": {
        "title": "Poops docs theme",
        "brand": "poops-docs-theme",
        "description": "Mock docs site used to preview the theme.",
        "lang": "en",
        "repo": "https://github.com/stamat/poops-docs-theme",
        "branch": "main",
        "jsonld": { "@type": "TechArticle" },
        "links": [
          { "title": "Docs", "url": "docs/" },
          { "title": "Changelog", "url": "https://github.com/stamat/poops-docs-theme/releases" }
        ],
        "iconLinks": [
          { "title": "npm", "url": "https://www.npmjs.com/package/poops-docs-theme", "icon": "npm" }
        ]
      },
      "searchIndex": "search-index.json",
      "nav": {
        "out": "nav.json",
        "root": "docs"
      }
    }
  },
  "copy": [{
    "in": ["dist/css", "dist/js"],
    "out": "preview/dist"
  }, {
    "in": [
      "node_modules/code-preview-element/dist/code-preview.min.css",
      "node_modules/code-preview-element/dist/code-preview-hljs.min.js"
    ],
    "out": "preview/dist/vendor"
  }],
  "serve": {
    "port": 4040
  },
  "livereload": true,
  "watch": ["scss", "src", "preview/src", "dist", "docs.html", "prose.html", "topbar.html", "navtree.html"]
}
