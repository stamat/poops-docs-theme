{
  "styles": [{
    "in": "scss/docs.scss",
    "out": "dist/css/docs.css",
    "options": {
      "minify": true,
      "justMinified": true
    }
  }],
  "scripts": [{
    "in": "src/docs.ts",
    "out": "dist/js/docs.js",
    "options": {
      "minify": true,
      "justMinified": true,
      "format": "iife",
      "target": "es2019"
    }
  }],
  "serve": {
    "port": 4041
  },
  "livereload": true,
  "watch": ["scss", "src"]
}
