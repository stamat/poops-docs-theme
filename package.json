{
  "name": "poops-docs-theme",
  "version": "4.0.1",
  "description": "Documentation theme (layout, styles, script) for Poops-built sites.",
  "license": "MIT",
  "author": "Nikola Stamatovic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stamat/poops-docs-theme.git"
  },
  "homepage": "https://github.com/stamat/poops-docs-theme",
  "keywords": [
    "poops",
    "poops-theme",
    "documentation",
    "docs",
    "theme",
    "static-site-generator",
    "nunjucks",
    "scss"
  ],
  "type": "module",
  "files": [
    "docs.html",
    "prose.html",
    "navtree.html",
    "topbar.html",
    "scss",
    "src",
    "dist"
  ],
  "scripts": {
    "build": "poops -b",
    "prepack": "npm run build",
    "preview": "poops",
    "test": "jest",
    "a11y": "node script/a11y",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"scss/**/*.scss\"",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:browsers": "stylelint --config stylelint.browsers.config.js --max-warnings 0 \"dist/css/*.css\"",
    "lint:es": "es-check es2020 \"dist/js/*.js\""
  },
  "peerDependencies": {
    "poops": ">=2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "axe-core": "^4.13.0",
    "code-preview-element": "^3.0.0",
    "es-check": "^9.6.4",
    "eslint": "^10.8.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "playwright-core": "^1.62.1",
    "poops": "^2.3.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-no-unsupported-browser-features": "^8.1.1",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "dependencies": {
    "book-of-elementals": "^0.7.1"
  }
}
