    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "poops": "^1.9.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
